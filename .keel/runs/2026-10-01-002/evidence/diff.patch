++# branch.head feature-x
++# branch.upstream origin/feature-x
++# branch.ab +2 -3
++1 .M N... 100644 100644 100644 aaa bbb config.yaml
++2 R. N... 100644 100644 100644 ccc ddd R100 new.py\told.py
++u UU N... ... foo
++? untracked.txt
++";
++        let st = parse_porcelain_v2(out);
