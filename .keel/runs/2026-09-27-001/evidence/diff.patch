+/// The host-side risk gate (docs/adr/0001-tool-call-risk-gating.md): runs
+/// before `container`/`docker exec` are ever built, so a `Deny` never
+/// reaches Docker. `chain_path` is a parameter, not resolved from `name`
+/// here, so this is testable without a real project on disk.
+fn gate(name: &str, m: &Manifest, cmd: &[String], chain_path: &Path) -> Result<()> {
+    let decision::Verdict::Deny { rule_id, reason } = decision::evaluate(cmd) else {
+        return Ok(());
+    };
+    let data = json!({
+        "project": name,
+        "argv": audit::redact_argv(cmd, &m.secrets),
+        "rule_id": rule_id,
+        "reason": reason,
+    });
+    audit::append_chained(chain_path, "decision", data)?;
+    anyhow::bail!("moor run: blocked by rule `{rule_id}`: {reason}");
+}
