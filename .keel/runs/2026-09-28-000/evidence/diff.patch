+++//! A deterministic, rules-only risk gate for commands `moor run`/`moor
+++//! keel` are about to hand to `docker exec`. See
+++//! `docs/adr/0001-tool-call-risk-gating.md`: this is the host-side
+++//! enforcement point. An in-sandbox agent hook can add *signal* later, but
+++//! is never the boundary — the same reason `docs/THREAT-MODEL.md` gives
+++//! for not trusting an in-image git pre-push hook applies to it too.
+++//!
+++//! No model, no daemon, no state: `evaluate` is a pure function over one
+++//! command's argv, checked against a fixed rule table, first match wins.
+++
+++#[derive(Debug, Clone, PartialEq, Eq)]
+++pub enum Verdict {
+++    Allow,
+++    Deny { rule_id: &'static str, reason: String },
+++}
+++
+++const CREDENTIAL_MARKERS: &[&str] = &[".ssh", ".aws", ".netrc", "id_rsa", ".pem"];
+++
+++pub fn evaluate(cmd: &[String]) -> Verdict {
+++    if let Some(reason) = credential_access(cmd) {
+++        return Verdict::Deny {
+++            rule_id: "credential_access",
+++            reason,
+++        };
+++    }
+++    if let Some(reason) = boundary_escape(cmd) {
+++        return Verdict::Deny {
+++            rule_id: "boundary_escape",
+++            reason,
+++        };
+++    }
+++    if let Some(reason) = destructive_wipe(cmd) {
+++        return Verdict::Deny {
+++            rule_id: "destructive",
+++            reason,
+++        };
+++    }
+++    Verdict::Allow
+++}
+++
+++fn credential_access(cmd: &[String]) -> Option<String> {
+++    cmd.iter()
+++        .find(|a| CREDENTIAL_MARKERS.iter().any(|m| a.contains(m)))
+++        .map(|a| format!("argument `{a}` names a credential path"))
+++}
+++
+++fn boundary_escape(cmd: &[String]) -> Option<String> {
+++    if cmd.first().map(|s| s == "sudo").unwrap_or(false) {
+++        return Some("command invokes `sudo`".to_string());
+++    }
+++    cmd.iter()
+++        .find(|a| a.contains("docker.sock"))
+++        .map(|a| format!("argument `{a}` references the Docker socket"))
+++}
+++
+++/// `rm` with both a recursive and a force flag, targeting `/`, `/workspace`,
+++/// or `~` exactly — a subdirectory of the workspace is left alone, since
+++/// that is ordinary cleanup, not a wipe.
+++fn destructive_wipe(cmd: &[String]) -> Option<String> {
+++    if cmd.first().map(String::as_str) != Some("rm") {
+++        return None;
+++    }
+++    let rest = &cmd[1..];
+++    let flags = || {
+++        rest.iter()
+++            .filter(|a| a.starts_with('-') && !a.starts_with("--"))
+++    };
+++    let has_r = flags().any(|a| a.to_lowercase().contains('r'))
+++        || rest.iter().any(|a| a == "--recursive");
+++    let has_f = flags().any(|a| a.contains('f')) || rest.iter().any(|a| a == "--force");
+++    if !(has_r && has_f) {
+++        return None;
+++    }
+++    rest.iter()
+++        .filter(|a| !a.starts_with('-'))
+++        .find(|a| matches!(a.trim_end_matches('/'), "" | "/workspace" | "~"))
+++        .map(|a| format!("`rm` recursively force-deletes `{a}`"))
+++}
+++
+++#[cfg(test)]
+++mod tests {
+++    use super::*;
+++
+++    fn argv(s: &str) -> Vec<String> {
+++        s.split_whitespace().map(String::from).collect()
+++    }
+++
+++    #[test]
+++    fn denies_known_credential_paths() {
+++        for cmd in [
+++            argv("cat /root/.ssh/id_rsa"),
+++            argv("cp ~/.aws/credentials /tmp/x"),
+++            argv("cat /workspace/.netrc"),
+++            argv("cat /etc/tls/server.pem"),
+++        ] {
+++            match evaluate(&cmd) {
+++                Verdict::Deny { rule_id, .. } => assert_eq!(rule_id, "credential_access"),
+++                Verdict::Allow => panic!("expected deny for {cmd:?}"),
+++            }
+++        }
+++        assert_eq!(evaluate(&argv("git status")), Verdict::Allow);
+++    }
+++
+++    #[test]
+++    fn denies_docker_socket_and_sudo() {
+++        match evaluate(&argv("curl --unix-socket /var/run/docker.sock http://x")) {
+++            Verdict::Deny { rule_id, .. } => assert_eq!(rule_id, "boundary_escape"),
+++            Verdict::Allow => panic!("expected deny"),
+++        }
+++        match evaluate(&argv("sudo cat /etc/shadow")) {
+++            Verdict::Deny { rule_id, .. } => assert_eq!(rule_id, "boundary_escape"),
+++            Verdict::Allow => panic!("expected deny"),
+++        }
+++    }
+++
+++    #[test]
+++    fn denies_recursive_wipe_of_workspace_or_home() {
+++        for cmd in [
+++            argv("rm -rf /workspace"),
+++            argv("rm -rf /"),
+++            argv("rm -rf ~"),
+++            argv("rm --recursive --force /workspace"),
+++        ] {
+++            match evaluate(&cmd) {
+++                Verdict::Deny { rule_id, .. } => assert_eq!(rule_id, "destructive"),
+++                Verdict::Allow => panic!("expected deny for {cmd:?}"),
+++            }
+++        }
+++        // A scoped delete inside the workspace is ordinary cleanup.
+++        assert_eq!(evaluate(&argv("rm -rf /workspace/target")), Verdict::Allow);
+++        assert_eq!(evaluate(&argv("rm file.txt")), Verdict::Allow);
+++    }
+++}
