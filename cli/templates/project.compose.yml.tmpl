# Rendered by the isolator CLI (Phase 4) with {{PLACEHOLDER}} substitution
# — no templating engine dependency, just string replace, so this file
# stays readable as ground truth for what actually gets applied.
#
# Network topology: the sandbox is attached ONLY to `{{PROJECT_NAME}}-internal`,
# which is marked `internal: true` — Docker gives that network no route to
# the outside world at all. The egress gateway is attached to both
# `{{PROJECT_NAME}}-internal` (to be reachable by the sandbox) and the
# default `{{PROJECT_NAME}}-egress-net` (which does have outbound access).
# So the sandbox's only possible path to the internet is through the
# gateway's allow-list — there is no bypass route, not even by ignoring
# the HTTP_PROXY env var.

services:
  sandbox:
    image: {{IMAGE}}
    container_name: {{PROJECT_NAME}}-sandbox
    read_only: true
    tmpfs:
      - /tmp
      # keel's evidence chain (keel ADR-0001), without a host bind mount.
      # /run/moor holds the posture attestation moor writes as root after
      # `up`; 0755 and root-owned, so the agent can read it but not
      # replace it. /run/moor-sink is where keel leaves chain payloads for
      # moor to fold into the host chain with `docker exec cat`.
      - /run/moor:mode=0755
      - /run/moor-sink:mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    cpus: "{{CPU_LIMIT}}"
    mem_limit: "{{MEM_LIMIT}}"
    pids_limit: {{PIDS_LIMIT}}
    networks:
      - internal
    environment:
      HTTP_PROXY: "http://egress:8888"
      HTTPS_PROXY: "http://egress:8888"
      NO_PROXY: "localhost,127.0.0.1"
      MOOR_CANARY_TOKEN: "{{CANARY_TOKEN}}"
      KEEL_RUNTIME_ATTESTATION: "/run/moor/posture.json"
      KEEL_CHAIN_SINK: "/run/moor-sink/keel.jsonl"
{{SECRET_ENV_LINES}}
{{GIT_CONFIG_ENV_LINES}}
    volumes:
      - workspace:/workspace
      - cache:/home/agent/.cache
      # Claude Code's own session/bookkeeping state (shell snapshots, todo
      # state, etc.) — without this, the read-only rootfs makes every Bash
      # tool call inside the agent fail with EROFS on `mkdir
      # /home/agent/.claude`. A named volume, not a bind mount: still no
      # host path crosses into the container.
      - claude-state:/home/agent/.claude
    command: ["sleep", "infinity"]
    depends_on:
      - egress

  egress:
    image: moor/egress:latest
    container_name: {{PROJECT_NAME}}-egress
    read_only: true
    tmpfs:
      - /run:mode=1777
      - /var/log/tinyproxy:mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    networks:
      - internal
      - egress-net
    environment:
      EXTRA_ALLOW_DOMAINS: "{{EXTRA_ALLOW_DOMAINS}}"

networks:
  internal:
    name: {{PROJECT_NAME}}-internal
    internal: true
  egress-net:
    name: {{PROJECT_NAME}}-egress-net

volumes:
  workspace:
    name: {{PROJECT_NAME}}-workspace
  cache:
    name: {{PROJECT_NAME}}-cache
  claude-state:
    name: {{PROJECT_NAME}}-claude-state
